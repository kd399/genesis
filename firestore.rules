rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── HighLevel connections ─────────────────────────────────────────────────
    match /highlevelConnections/{connectionId} {
      allow read: if request.auth != null && request.auth.uid == connectionId;
      allow write: if request.auth != null && request.auth.uid == connectionId;
    }

    // ── Projects ──────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      // Allow read if authenticated and (doc doesn't exist yet OR user owns it)
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;

      // ── Files ───────────────────────────────────────────────────────────
      // Use exists() as a top-level function — NOT as .exists() method on get()
      match /files/{fileId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }

      // ── Snapshots ────────────────────────────────────────────────────────
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }

      // ── Messages ─────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }
  }
}
